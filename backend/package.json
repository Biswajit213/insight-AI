{
  "name": "insightai-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for InsightAI - Turn your data into decisions.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "check-db": "ts-node src/check-database-users.ts"
  },
  "keywords": [
    "ai",
    "analytics",
    "data",
    "insightai",
    "supabase",
    "mistral-ai",
    "express",
    "typescript"
  ],
  "author": "InsightAI Engineering",
  "license": "MIT",
  "dependencies": {
    "@mistralai/mistralai": "^1.5.0",
    "@supabase/supabase-js": "^2.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jest": "^29.7.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
